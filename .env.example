# ===== PostgreSQL（既存 gamma10_exp / mainview）=====
DB_HOST=130.158.92.41
DB_PORT=5432
DB_NAME=gamma10_exp
DB_USER=prc
DB_PASSWORD=

# ===== デモモード =====
# 0: 学内 LAN 本番（DB + FTP）
# 1: DB/FTP 無しで UI だけ確認
USE_DEMO=0

# ===== 波形データ =====
DATA_ROOT=./data

# ===== FTP（TekeTekeKun/ftp.php 相当・kasumi）=====
# リモートパス: {FTP_BASE_PATH}/{shotNo}/{port} （拡張子なし・Ha/DM サブディレクトリなし）
# kasumi（DB ホスト 130.158.92.41 ではない）
FTP_HOST=130.158.92.4
FTP_PORT=21
FTP_USER=mwls
FTP_PASSWORD=
FTP_BASE_PATH=/usr2/shot
FTP_TIMEOUT_SEC=30

# ===== API =====
# ブラウザは nginx と同じオリジンで /api を呼ぶ。別オリジンが必要なときだけ列挙する。
# 例: API_CORS_ORIGINS=http://127.0.0.1:5173
# `*` は資格情報付きの反射になるため API が無視する。
API_CORS_ORIGINS=
MAX_SHOT_LIMIT=30

# ===== 学内 LAN 公開 =====
# ブラウザ: http://130.158.92.<このホスト>:8080
# 例: http://130.158.92.11:8080
HOST_HTTP_PORT=8080
# 全 NIC 公開が既定。特定 IP だけに縛る場合:
# HOST_BIND_IP=130.158.92.11
HOST_BIND_IP=0.0.0.0

# ===== 学内 nginx-proxy（docker-compose.campus.yml 利用時のみ）=====
# VIRTUAL_HOST=g10db.prc.tsukuba.ac.jp
# LETSENCRYPT_HOST=g10db.prc.tsukuba.ac.jp
# LETSENCRYPT_EMAIL=

# ===== Basic 認証 =====
# 現在は未導入。入口 nginx は auth_basic off。
BASIC_AUTH_USER=g10db
BASIC_AUTH_PASSWORD=
