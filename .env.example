# ===== PostgreSQL（既存 gamma10_exp / mainview）=====
DB_HOST=130.158.92.41
DB_PORT=5432
DB_NAME=gamma10_exp
DB_USER=prc
DB_PASSWORD=

# ===== デモモード =====
# 1: DB/FTP 無しで UI 確認（開発用）
# 0: 本番（パラメータ化 SQL + FTP/ローカル波形）
USE_DEMO=0

# ===== 波形データ =====
DATA_ROOT=./data

# ===== FTP（TekeTekeKun/ftp.php 相当・kasumi 等）=====
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_BASE_PATH=/G10DATA
FTP_TIMEOUT_SEC=30

# ===== API =====
API_CORS_ORIGINS=*
MAX_SHOT_LIMIT=30

# ===== 公開（nginx-proxy）=====
VIRTUAL_HOST=g10db.prc.tsukuba.ac.jp
LETSENCRYPT_HOST=g10db.prc.tsukuba.ac.jp
LETSENCRYPT_EMAIL=
HOST_HTTP_PORT=8080

# ===== Basic 認証（学外のみ。学内 130.158.92.0/24 はスキップ）=====
BASIC_AUTH_USER=g10db
BASIC_AUTH_PASSWORD=
