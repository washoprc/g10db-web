# ===== PostgreSQL（既存 gamma10_exp / mainview）=====
DB_HOST=130.158.92.41
DB_PORT=5432
DB_NAME=gamma10_exp
DB_USER=prc
DB_PASSWORD=

# ===== デモモード =====
# 1: DB/FTP 無しで UI 確認（localhost 用・デフォルト）
# 0: 本番（パラメータ化 SQL + FTP/ローカル波形）
USE_DEMO=1

# ===== 波形データ =====
DATA_ROOT=./data

# ===== FTP（TekeTekeKun/ftp.php 相当・kasumi）=====
# リモートパス: {FTP_BASE_PATH}/{shotNo}/{port} （拡張子なし・Ha/DM サブディレクトリなし）
# 例: /usr2/shot/200000/CTHA01
FTP_HOST=130.158.92.4
FTP_PORT=21
FTP_USER=mwls
FTP_PASSWORD=
FTP_BASE_PATH=/usr2/shot
FTP_TIMEOUT_SEC=30

# ===== API =====
API_CORS_ORIGINS=*
MAX_SHOT_LIMIT=30

# ===== 公開ポート（localhost）=====
HOST_HTTP_PORT=8080

# ===== 学内 nginx-proxy（docker-compose.campus.yml 利用時のみ）=====
# VIRTUAL_HOST=g10db.prc.tsukuba.ac.jp
# LETSENCRYPT_HOST=g10db.prc.tsukuba.ac.jp
# LETSENCRYPT_EMAIL=

# ===== Basic 認証（学外のみ。学内 130.158.92.0/24 はスキップ）=====
BASIC_AUTH_USER=g10db
BASIC_AUTH_PASSWORD=
